# Local development (MinIO)
DATABASE_URL=postgresql://lanceon:lanceon_dev@localhost:5432/lance_on
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lanceon-videos
S3_REGION=us-east-1

# Public MinIO URL reachable from phones (LAN IP)
# S3_PUBLIC_ENDPOINT_URL=http://192.168.1.50:9000

# --- AWS EC2 production (see deploy/.env.aws.example) ---
# S3_ENDPOINT_URL=
# S3_PUBLIC_ENDPOINT_URL=
# S3_ACCESS_KEY=AKIA...
# S3_SECRET_KEY=...
# S3_BUCKET=lanceon-videos-yourname
# S3_REGION=ap-southeast-2

RECORDING_RETENTION_HOURS=48
CLIP_DURATION_SECONDS=30

ADMIN_EMAIL=admin@lanceon.com.br
ADMIN_PASSWORD=change-me
ADMIN_NAME=Administrador

# Firebase Auth (required to verify Google sign-in ID tokens from the app)
FIREBASE_PROJECT_ID=lance-on

# Optional fallback: Google OAuth Web Client ID(s) (comma-separated OK)
# GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
