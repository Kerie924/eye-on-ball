[Unit]
Description=Lance On API (FastAPI / uvicorn)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/lance-on/backend
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/lance-on/backend/.env
ExecStart=/opt/lance-on/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
