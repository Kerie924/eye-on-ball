# Copy to /opt/lance-on/backend/.env on the EC2 instance

DATABASE_URL=postgresql://lanceon:CHANGE_DB_PASSWORD@127.0.0.1:5432/lance_on
SECRET_KEY=generate-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Real Amazon S3 — leave endpoint empty
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY=AKIA...
S3_SECRET_KEY=...
S3_BUCKET=lanceon-videos-yourname
S3_REGION=ap-southeast-2

RECORDING_RETENTION_HOURS=48
CLIP_DURATION_SECONDS=30

ADMIN_EMAIL=admin@lanceon.com.br
ADMIN_PASSWORD=change-me-strong
ADMIN_NAME=Administrador

# GOOGLE_CLIENT_ID=113076073338-....apps.googleusercontent.com
