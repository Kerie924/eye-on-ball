# Leave empty in local dev to use the Vite proxy (/api → api.lanceonpara.com.br).
# For production builds, set the public API origin:
# VITE_API_URL=https://api.lanceonpara.com.br
VITE_API_URL=

# Store links for the download buttons. Play Store defaults to com.lanceon.app.
# VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.lanceon.app
# VITE_APP_STORE_URL=https://apps.apple.com/app/idXXXXXXXXX

