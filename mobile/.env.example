# Backend API URL for the mobile app (NOT the admin panel).
EXPO_PUBLIC_API_URL=https://api.lanceonpara.com.br

# Firebase Auth (Project settings → General → Your apps → Web app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=lance-on.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=lance-on
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Google Web client ID from the same Firebase / Google Cloud project.
# Firebase console → Authentication → Sign-in method → Google → Web SDK configuration
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
