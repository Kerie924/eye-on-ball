# Backend API URL for the mobile app (NOT the admin panel).
EXPO_PUBLIC_API_URL=https://api.lanceonpara.com.br

# Google OAuth 2.0 — create OAuth Client IDs at:
# https://console.cloud.google.com/apis/credentials
# For Expo Go testing, the Web client ID is required.
# Also set the same Web client ID on the backend as GOOGLE_CLIENT_ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
